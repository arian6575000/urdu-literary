{
  "expo": {
    "name": "اردو ادبی ڈائری",
    "slug": "urdu-literary-app",
    "scheme": "urduliterary",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#174C3A"
    },
    "android": {
      "package": "com.urduliterary.app",
      "adaptiveIcon": {
        "backgroundColor": "#174C3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ایپ کھولنے کے لیے بایومیٹرک استعمال کریں"
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "آواز سے لکھنے کے لیے مائیکروفون درکار ہے"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "آواز سے لکھنے کے لیے مائیکروفون درکار ہے",
          "speechRecognitionPermission": "اردو آواز پہچاننے کے لیے اجازت درکار ہے"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "کارڈ کے پس منظر کے لیے تصویر چننے کی اجازت درکار ہے",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "تیار کارڈ گیلری میں محفوظ کرنے کے لیے اجازت درکار ہے",
          "photosPermission": "تیار کارڈ گیلری میں محفوظ کرنے کے لیے اجازت درکار ہے",
          "granularPermissions": [
            "photo"
          ],
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "extra": {
      "speechProxyUrl": ""
    },
    "experiments": {
      "typedRoutes": false
    },
    "userInterfaceStyle": "automatic"
  }
}
